{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tramitando-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "tramitando", "database_id": "local-tramitando", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "PRUEBAS", "bucket_name": "tramitando-pruebas" }],
  "triggers": { "crons": ["0 6 * * 1", "0 5 * * *"] },
  "vars": { "ACCESS_TEAM": "", "ACCESS_AUD": "" }
  // Secretos (wrangler secret put): TURNSTILE_SECRET, INGEST_TOKEN, IP_SALT
  // Local: copiá .dev.vars.ejemplo a .dev.vars
}
