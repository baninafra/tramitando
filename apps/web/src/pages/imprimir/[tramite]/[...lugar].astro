---
// Vista del checklist lista para imprimir o guardar en PDF ("Descargá el checklist").
import '@fontsource-variable/figtree';
import '../../../styles/global.css';
import Icono from '../../../components/Icono.astro';
import { obtenerFicha, USA_DATOS_DE_EJEMPLO } from '../../../lib/data';
import { formatoFecha, formatoMonto } from '../../../lib/formato';
import { nombreDeLugar } from '../../../lib/seo';

const partes = (Astro.params.lugar ?? '').split('/').filter(Boolean);
if (partes.length > 2) return Astro.rewrite('/404');
const resultado = await obtenerFicha(Astro.params.tramite!, partes[0], partes[1]);
if (!resultado || resultado.tipo !== 'ficha') return Astro.rewrite('/404');
const f = resultado.ficha;
const v = f.variante;
const lugar = nombreDeLugar(f.pedido);
const titulo = lugar ? `${f.tramite.nombre} en ${lugar}` : f.tramite.nombre;
const gratis = v.costos.length > 0 && v.costos.every((c) => c.monto === 0);
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>Checklist: {titulo} | tramitando</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="hoja">
      <div class="barra no-imprimir">
        <a class="btn btn-secundario" href={f.url}><Icono nombre="arrow-left" />Volver a la ficha</a>
        <button class="btn btn-primario" type="button" data-imprimir><Icono nombre="printer" />Imprimir o guardar en PDF</button>
      </div>

      <header class="encabezado">
        <picture>
          <source srcset="/tramitando-logo-negativo.svg" media="screen and (prefers-color-scheme: dark)" />
          <img src="/tramitando-logo.svg" alt="tramitando" width="130" height="26" />
        </picture>
        <h1>{titulo}</h1>
        <p class="nota">
          {f.estado === 'verificado' ? `Verificado el ${formatoFecha(v.verificacion.fecha)}` : `Puede estar desactualizado: última verificación el ${formatoFecha(v.verificacion.fecha)}`}
          {f.heredada && ` · Versión de ${nombreDeLugar(f.lugarVariante) ?? 'Nación'}`}
        </p>
        {USA_DATOS_DE_EJEMPLO && <p class="nota">Datos de ejemplo, no reales.</p>}
      </header>

      <section>
        <h2>Qué necesitás</h2>
        <ul class="lista-papel">
          {v.requisitos.map((r) => (
            <li><span class="caja" aria-hidden="true"></span><span>{r.texto}{r.aclaracion && <small>{r.aclaracion}</small>}</span></li>
          ))}
        </ul>
      </section>

      <section class="datos">
        <div>
          <h2>Cuánto cuesta</h2>
          {v.costos.length === 0 ? <p>{v.costoNota ?? 'Varía según el lugar.'}</p> : gratis ? <p>Gratis</p> : (
            <ul>{v.costos.map((c) => <li>{c.concepto}: <strong>{c.monto === 0 ? 'Gratis' : formatoMonto(c.monto)}</strong></li>)}</ul>
          )}
        </div>
        <div>
          <h2>Cuánto tarda</h2>
          <p>{v.plazo.resolucion}</p>
          {v.pasos.turno && <p>{v.pasos.turno}</p>}
        </div>
      </section>

      {f.oficinas.length > 0 && (
        <section>
          <h2>Dónde se hace</h2>
          <ul>{f.oficinas.map((o) => <li><strong>{o.nombre}</strong>: {o.direccion}, {o.localidad}.{o.horario && <> {o.horario}.</>}</li>)}</ul>
        </section>
      )}

      <footer class="pie-hoja">
        <p>Fuentes: {v.fuentes.map((x) => x.url).filter((u, i, a) => a.indexOf(u) === i).join(' · ')}</p>
        <p>Ficha completa: {new URL(f.url, Astro.site).href}</p>
        <p>Tramitando es un sitio independiente y no pertenece a ningún organismo del Estado. Verificá siempre en la fuente oficial antes de hacer tu trámite.</p>
      </footer>
    </main>
    <script>
      document.querySelector('[data-imprimir]')?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>

<style>
  .hoja { max-width: 760px; margin: 0 auto; padding: var(--espacio-5) var(--espacio-4); display: grid; gap: var(--espacio-6); }
  .barra { display: flex; flex-wrap: wrap; gap: var(--espacio-2); }
  .encabezado { display: grid; gap: var(--espacio-3); }
  .encabezado img { width: 130px; height: auto; }
  .nota { font: var(--t-nota); color: var(--tinta-suave); }
  section { display: grid; gap: var(--espacio-3); }
  section ul:not(.lista-papel) { padding-left: var(--espacio-5); display: grid; gap: var(--espacio-1); }
  .lista-papel { list-style: none; padding: 0; display: grid; gap: var(--espacio-3); }
  .lista-papel li { display: grid; grid-template-columns: 22px 1fr; gap: var(--espacio-3); align-items: start; }
  .caja { width: 22px; height: 22px; margin-top: 2px; border: 1.5px solid var(--borde-fuerte); border-radius: var(--radio-chico); }
  small { display: block; font: var(--t-cuerpo-chico); color: var(--tinta-2); }
  .datos { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--espacio-5); }
  .datos > div { display: grid; gap: var(--espacio-2); align-content: start; }
  .pie-hoja { display: grid; gap: var(--espacio-2); border-top: 1px solid var(--borde); padding-top: var(--espacio-4); font: var(--t-nota); color: var(--tinta-2); overflow-wrap: anywhere; }

  @media print {
    @page { margin: 16mm; }
    .hoja { padding: 0; max-width: none; gap: 20px; }
    .caja { border-color: #000; }
    .nota, small, .pie-hoja { color: #333; }
  }
</style>
